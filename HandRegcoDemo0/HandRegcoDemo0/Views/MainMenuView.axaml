<fa:FluentWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:vm="using:HandRegcoDemo0.ViewModels"
                 xmlns:fa="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
                 x:Class="HandRegcoDemo0.Views.MainMenuView"
                 x:DataType="vm:MainMenuViewModel"
                 Width="380" Height="420"
                 Title="Hand Recognition Demo"
                 Background="Transparent"
                 CornerRadius="24"
                 TransparencyLevelHint="AcrylicBlur"
                 WindowStartupLocation="CenterScreen"
                 CanResize="False">

	<fa:FluentWindow.Background>
		<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#667eea" Offset="0.0"/>
			<GradientStop Color="#764ba2" Offset="0.5"/>
			<GradientStop Color="#f093fb" Offset="1.0"/>
		</LinearGradientBrush>
	</fa:FluentWindow.Background>

	<fa:FluentWindow.Styles>
		<!-- Hover effect cho main buttons -->
		<Style Selector="Button.MainButton:pointerover">
			<Setter Property="Opacity" Value="0.9"/>
		</Style>

		<!-- Hover effect cho secondary buttons -->
		<Style Selector="Button.SecondaryButton:pointerover">
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="Background" Value="#FFFFFF40"/>
		</Style>
	</fa:FluentWindow.Styles>

	<Grid>
		<!-- Header Section -->
		<StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0">
			<!-- App Icon/Logo -->
			<Border Background="White"
                    Width="64" Height="64"
                    CornerRadius="32"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
				<TextBlock Text="🤚"
                          FontSize="32"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
			</Border>

			<!-- App Title -->
			<TextBlock Text="Hand Recognition"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="White"
                      HorizontalAlignment="Center"
                      TextAlignment="Center"
                      Margin="0,0,0,4"/>

			<!-- App Subtitle -->
			<TextBlock Text="Demo Application"
                      FontSize="14"
                      FontWeight="Light"
                      Foreground="White"
                      Opacity="0.8"
                      HorizontalAlignment="Center"
                      TextAlignment="Center"
                      Margin="0,0,0,24"/>
		</StackPanel>

		<!-- Main Menu Buttons -->
		<StackPanel VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Spacing="16"
                   Margin="0,20,0,0">

			<!-- Live Button -->
			<Button Content="🎥 Live Detection"
                   Command="{Binding LiveCommand}"
                   Classes="MainButton"
                   Width="200"
                   Height="52"
                   Background="#4facfe"
                   Foreground="White"
                   FontWeight="SemiBold"
                   FontSize="16"
                   CornerRadius="26"
                   BorderThickness="0"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>

			<!-- Record Button -->
			<Button Content="📹 Record Session"
                   Command="{Binding RecordCommand}"
                   Classes="MainButton"
                   Width="200"
                   Height="52"
                   Background="#ff6b6b"
                   Foreground="White"
                   FontWeight="SemiBold"
                   FontSize="16"
                   CornerRadius="26"
                   BorderThickness="0"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>


		</StackPanel>

		<!-- Footer Section -->
		<StackPanel VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Orientation="Horizontal"
                   Spacing="16"
                   Margin="0,0,0,24">

			<Button Content="Help"
                   Width="80"
                   Height="32"
                   Background="Transparent"
                   BorderBrush="White"
                   BorderThickness="1"
                   Foreground="White"
                   FontWeight="Medium"
                   FontSize="13"
                   CornerRadius="16"
                   Opacity="0.9"
                   Classes="SecondaryButton"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>

			<Button Content="Exit"
                   Command="{Binding ExitCommand}"
                   Classes="SecondaryButton"
                   Width="80"
                   Height="32"
                   Background="Transparent"
                   BorderBrush="White"
                   BorderThickness="1"
                   Foreground="White"
                   FontWeight="Medium"
                   FontSize="13"
                   CornerRadius="16"
                   Opacity="0.9"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center"/>
		</StackPanel>

		<!-- Version Info -->
		<TextBlock Text="v1.0.0"
                  FontSize="11"
                  Foreground="White"
                  Opacity="0.6"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,16,8"/>
	</Grid>
</fa:FluentWindow>